{
  "name": "${localWorkspaceFolderBasename}_v1.0.0",
  "image": "ghcr.io/johnpaulgosling/mlnn_docker:latest",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "RStudio",
      "requireLocalPort": false,
      "onAutoForward": "openBrowser",
      "protocol": "https",
      "waitFor": "silent",
      "elevateIfNeeded": true
    }
  },
  "postAttachCommand": "sudo rstudio-server start",
  "customizations": {
    "codespaces": {
      "openFiles": []
    }
  }
}
